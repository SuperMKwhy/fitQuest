# Copy this file to .env and adjust as needed. docker-compose.yml reads these
# for both the postgres and server services.

POSTGRES_USER=fitquest
POSTGRES_PASSWORD=fitquest
POSTGRES_DB=fitquest
POSTGRES_PORT=5432

SERVER_PORT=3000
# Generate a real one for anything beyond local dev: `openssl rand -hex 32`
JWT_SECRET=dev-secret-change-me

# AI Buddy chat / food scan — Google AI Studio (Gemini) API key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
