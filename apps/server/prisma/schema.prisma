generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  profile    Profile?
  activities Activity[]

  friendshipsInitiated Friendship[] @relation("FriendshipInitiator")
  friendshipsReceived  Friendship[] @relation("FriendshipReceiver")
}

model Profile {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  // "build_muscle" | "lose_weight" | "improve_health" — set during onboarding
  goal        String?
  heightCm    Float?
  weightKg    Float?
  hairStyle   String  @default("short")
  skinTone    String  @default("fair")

  level Int @default(1)
  xp    Int @default(0)
  // Cumulative XP ever earned — used for leaderboard ranking, since `xp`
  // above is only the in-progress remainder toward the next level and
  // resets on level-up, so it isn't comparable across users at different levels.
  totalXp Int @default(0)
  coins Int @default(0)
  gems  Int @default(0)

  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Activity {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "run" | "quest_game"
  type         String
  distanceM    Float?
  durationS    Int
  caloriesKcal Int?
  // arm-swing / Flappy Bird score, for type = "quest_game"
  score        Int?

  xpEarned    Int
  coinsEarned Int

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Friendship {
  id String @id @default(uuid())

  requesterId String
  requester   User   @relation("FriendshipInitiator", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User   @relation("FriendshipReceiver", fields: [addresseeId], references: [id], onDelete: Cascade)

  // "pending" | "accepted"
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([requesterId, addresseeId])
}

model ShopItem {
  id         String  @id @default(uuid())
  name       String
  category   String // hair | shirt | pants | shoes | pet | accessory
  priceCoins Int?
  priceGems  Int?
  iconKey    String
}
